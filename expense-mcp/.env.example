# Copy to .env and fill in. docker compose reads this file automatically.
# Single-domain production: everything is served from https://mydomain.com
#   /api/*, /oidc/*, /mcp, /.well-known/*  -> expenses-server
#   everything else                         -> expense-web (frontend)
#
# Replace <tenant> with your LoginRadius tenant and <app-name> with the OIDC
# app you created in the LoginRadius dashboard.

# --- expenses-server (runtime) ---
# Every other LoginRadius URL (JWKS, token endpoints) is derived from LR_ISSUER
# in src/config/index.ts — do not add them here.
LR_ISSUER=https://<tenant>.hub.loginradius.com/service/oidc/<app-name>
# Issuer of service / token-exchange tokens. Must match the token `iss` claim
# byte-for-byte (including the trailing slash). REST-only; MCP rejects it.
LR_SERVICE_ISSUER=https://<tenant>.hub.loginradius.com/service/oauth/
LR_CLIENT_ID=
LR_CLIENT_SECRET=
LR_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_post

# Resource identifiers double as token audiences, so they must match what the
# client requests exactly.
MCP_RESOURCE_URL=https://mydomain.com/mcp
REST_RESOURCE_URL=https://mydomain.com/api

OIDC_REDIRECT_URI=https://mydomain.com/callback
CORS_ORIGIN=https://mydomain.com

# --- expense-web (build-time, baked into the static bundle by Vite) ---
VITE_LR_AUTHORIZE_URL=https://<tenant>.hub.loginradius.com/authorize
VITE_LR_CLIENT_ID=
VITE_LR_REDIRECT_URI=https://mydomain.com/callback
# Must match REST_RESOURCE_URL above. This is the URL the browser calls, so it is
# the public domain — never the server's internal container port.
VITE_REST_RESOURCE_URL=https://mydomain.com/api
