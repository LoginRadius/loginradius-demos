# Copy to .env for local development.
# Replace <tenant> with your LoginRadius tenant and <app-name> with the OIDC
# app you created in the LoginRadius dashboard.

# Server
PORT=3000
NODE_ENV=development
DATABASE_PATH=./data/expense.db
# The React client calls this server directly on its own origin, so that origin
# must be listed here. A wildcard cannot be used: the browser rejects "*" on
# credentialed requests, and the login flow needs cookies. Comma-separate to
# allow more than one.
CORS_ORIGIN=http://localhost:5173

# LoginRadius. Every other LoginRadius URL (JWKS, token endpoints) is derived
# from LR_ISSUER in src/config/index.ts — do not add them here.
LR_ISSUER=https://<tenant>.hub.loginradius.com/service/oidc/<app-name>
# Issuer of service / token-exchange tokens. Must match the token `iss` claim
# byte-for-byte (including the trailing slash). REST-only; MCP rejects it.
LR_SERVICE_ISSUER=https://<tenant>.hub.loginradius.com/service/oauth/
LR_CLIENT_ID=
LR_CLIENT_SECRET=
LR_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_post

# MCP resource identifier (and audience for MCP access tokens).
MCP_RESOURCE_URL=http://localhost:3000/mcp
MCP_SERVER_NAME=Expense Management MCP Server
MCP_SERVER_VERSION=1.0.0
MCP_SERVER_ACTOR_SCOPES=expense:submit expense:view:own expense:view:team expense:view:all expense:approve expense:report:generate

# REST resource identifier (and audience for REST access tokens). The /api
# path is what distinguishes it from MCP_RESOURCE_URL on the same host.
REST_RESOURCE_URL=http://localhost:3000/api

# OIDC callback for the React client
OIDC_REDIRECT_URI=http://localhost:5173/callback

# Cookie (COOKIE_SECURE is derived from NODE_ENV=production — not set here)
COOKIE_NAME=expense_session
