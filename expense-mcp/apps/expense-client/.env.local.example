# Copy to .env.local for local development.
# Replace <tenant> with your LoginRadius tenant and <app-name> with the OIDC
# app you created in the LoginRadius dashboard.
# Sign-out also derives the LoginRadius hub origin from this value, to end the
# session the auth server holds on its own domain.
VITE_LR_AUTHORIZE_URL=https://<tenant>.hub.loginradius.com/authorize
VITE_LR_CLIENT_ID=<client_id>
VITE_LR_REDIRECT_URI=http://localhost:5173/callback

# REST resource identifier, and the URL the client calls directly — there is no
# dev proxy. Must match the server's REST_RESOURCE_URL exactly: it is also sent
# as the OAuth `resource` parameter and becomes the token audience. The /oidc
# routes are derived from this value's origin.
# The server's CORS_ORIGIN must list this app's origin (http://localhost:5173).
VITE_REST_RESOURCE_URL=http://localhost:3000/api
