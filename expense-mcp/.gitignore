# Misc
.DS_Store
*.pem
.data/

# SQLite working files. The database is created by `pnpm run db:seed`, so it is
# never committed — a checked-in copy would hold users that no tenant knows.
# Unanchored on purpose: the database lives in apps/expenses-server/data/.
*.db
*.db-shm
*.db-wal
