# Copy to .env.local and fill in values from your LoginRadius dashboard.
# The tenant MUST be B2C (app config IsB2BEnabled = false) — see README.
# DO NOT commit real keys. Never paste them into chat.

# ── Browser (inlined into the client bundle — public values only) ─────────
NEXT_PUBLIC_LOGINRADIUS_API_KEY=
NEXT_PUBLIC_LOGINRADIUS_OIDC_APP_NAME=
NEXT_PUBLIC_LOGINRADIUS_CLIENT_ID=

# Leave blank to use the domain baked into the installed SDK build.
NEXT_PUBLIC_AUTH_DOMAIN=

# Space-separated OIDC scopes requested on the authorize call.
NEXT_PUBLIC_OIDC_SCOPES=openid profile email

# Render SDK widgets on the account page. Set "false" for the static BBC mock UI.
NEXT_PUBLIC_USE_SDK=true

# ── Server only (never prefixed NEXT_PUBLIC_ — these must not reach the
#    browser). Used by /api/linked-accounts to mint an M2M token. ──────────
LOGINRADIUS_M2M_CLIENT_ID=
LOGINRADIUS_M2M_CLIENT_SECRET=

# Where POST /service/oauth/token lives, e.g. <tenant>.hub.loginradius.com.
LOGINRADIUS_HUB_DOMAIN=

# Management API host. Defaults to https://api.loginradius.com.
LOGINRADIUS_MANAGE_HOST=

# Audience the M2M token is minted for.
LOGINRADIUS_M2M_AUDIENCE=https://api.loginradius.com/identity/v2/manage

# Name of the custom object holding LinkedAccounts[] and Profiles[].
LOGINRADIUS_LINK_OBJECT_NAME=link_account
