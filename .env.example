# Copy to .env.local and fill in values from your LoginRadius dashboard.
# DO NOT commit real keys. Never share these in chat or pastes.

VITE_LOGINRADIUS_API_KEY=
VITE_LOGINRADIUS_API_DOMAIN=
VITE_LOGINRADIUS_APP_NAME=
VITE_LOGINRADIUS_OIDC_APP_NAME=
VITE_LOGINRADIUS_CLIENT_ID=

# Feature flag — set to "false" to render the mock UI in /admin pages instead of SDK widgets.
VITE_USE_SDK=true
