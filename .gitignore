# ---------------------------------------------------------------------------
# LoginRadius demos — root .gitignore
# Public-facing monorepo: Vite / Next.js / Nuxt / Angular / Svelte / Solid / Vue
# Security-first: never commit secrets, credentials, or tenant API keys.
# ---------------------------------------------------------------------------

# ----- Secrets & environment ------------------------------------------------
# Block every dotenv variant; allow only example/template files so contributors
# know what to set. NEVER commit real LoginRadius API keys, secrets, or tokens.
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example

# Common credential / key files
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
*.keystore
secrets.json
credentials.json
serviceAccount*.json
gha-creds-*.json

# Cloud / CI provider local creds
.aws/
.gcloud/
.azure/
.vercel
.netlify
.firebase/
.sst/

# ----- Dependencies ---------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/cache
.yarn/unplugged
.yarn/build-state.log
.yarn/install-state.gz
jspm_packages/
bower_components/

# ----- Build output ---------------------------------------------------------
dist/
build/
out/
.output/
.vercel/
.netlify/
.serverless/
.fusebox/
.dynamodb/
.tern-port
storybook-static/

# Vite
.vite/
vite.config.*.timestamp-*

# Next.js
.next/
next-env.d.ts
.swc/

# Nuxt
.nuxt/
.nitro/
.data/

# Angular
.angular/

# Svelte / SvelteKit
.svelte-kit/

# Solid / Astro / Remix
.solid/
.astro/
.remix/

# Gatsby
.cache/
public/build/

# Turbo / Nx / Rush
.turbo/
.nx/
.rush/

# ----- Test, coverage, profiling --------------------------------------------
coverage/
*.lcov
.nyc_output/
.jest-cache/
.vitest-cache/
playwright-report/
test-results/
blob-report/
playwright/.cache/
cypress/videos/
cypress/screenshots/
cypress/downloads/

# ----- TypeScript / linters / formatters ------------------------------------
*.tsbuildinfo
.eslintcache
.stylelintcache
.prettiercache

# ----- Logs & diagnostics ---------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
pids/
*.pid
*.seed
*.pid.lock

# ----- Caches ---------------------------------------------------------------
.npm/
.pnpm-store/
.yarn-integrity
.parcel-cache/
.rpt2_cache/
.rts2_cache_*/
.webpack/
.rollup.cache/
.esbuild/

# ----- Editors & IDEs -------------------------------------------------------
.idea/
.vscode/*
.history/
*.swp
*.swo
*~
.project
.classpath
.settings/

# JetBrains
*.iml
*.ipr
*.iws

# ----- OS junk --------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ----- Misc -----------------------------------------------------------------
*.tgz
*.tar.gz
*.zip
*.bak
*.tmp
tmp/
temp/
